<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Website Ng Iniwan - Cloud Storage</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-slate-900 via-slate-800 to-indigo-950 min-h-screen text-slate-100 p-4 sm:p-8">
    <div class="max-w-3xl mx-auto">
        <!-- Header -->
        <header class="mb-8 text-center">
            <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-300 mb-2">
                Website Ng Iniwan
            </h1>
            <p class="text-slate-400 text-sm sm:text-base">Secure 24/7 Cloud Storage Powered by Cloudinary</p>
        </header>

        <!-- Upload Card -->
        <div class="bg-slate-800/80 backdrop-blur border border-slate-700/60 rounded-2xl p-6 shadow-xl mb-8">
            <h2 class="text-lg font-semibold mb-4 text-indigo-300 flex items-center gap-2">
                📂 Upload New File
            </h2>
            <form action="/upload" method="POST" enctype="multipart/form-data" class="space-y-4">
                <div class="flex items-center justify-center w-full">
                    <label class="flex flex-col items-center justify-center w-full h-32 border-2 border-slate-600 border-dashed rounded-xl cursor-pointer bg-slate-900/50 hover:bg-slate-900 transition">
                        <div class="flex flex-col items-center justify-center pt-5 pb-6 px-4 text-center">
                            <svg class="w-8 h-8 mb-2 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
                            </svg>
                            <p class="text-sm text-slate-300"><span class="font-semibold">Click to browse</span> or drag and drop</p>
                            <p class="text-xs text-slate-500 mt-1">Images, documents, videos, and archives supported</p>
                        </div>
                        <input type="file" name="file" required class="hidden" onchange="this.form.submit()" />
                    </label>
                </div>
            </form>
        </div>

        <!-- Stored Files Section -->
        <div class="bg-slate-800/80 backdrop-blur border border-slate-700/60 rounded-2xl p-6 shadow-xl">
            <h2 class="text-lg font-semibold mb-4 text-indigo-300 flex items-center justify-between">
                <span>☁️ Your Cloud Files</span>
                <span class="text-xs bg-indigo-500/20 text-indigo-300 px-2.5 py-1 rounded-full border border-indigo-500/30">
                    <%= files.length %> Stored
                </span>
            </h2>

            <% if (files.length > 0) { %>
                <div class="space-y-3">
                    <% files.forEach(file => { %>
                        <div class="flex items-center justify-between p-4 bg-slate-900/60 border border-slate-700/40 rounded-xl hover:border-indigo-500/50 transition">
                            <div class="flex items-center space-x-3 overflow-hidden">
                                <div class="p-2.5 bg-indigo-500/10 text-indigo-400 rounded-lg shrink-0">
                                    📄
                                </div>
                                <div class="truncate">
                                    <p class="font-medium text-slate-200 truncate text-sm sm:text-base">
                                        <%= file.original_filename || file.public_id %>
                                    </p>
                                    <p class="text-xs text-slate-400 mt-0.5">
                                        <%= Math.round(file.bytes / 1024) %> KB • Uploaded <%= new Date(file.created_at).toLocaleDateString() %>
                                    </p>
                                </div>
                            </div>
                            <div class="flex items-center space-x-2 shrink-0 ml-4">
                                <a href="<%= file.secure_url %>" target="_blank" class="px-3.5 py-1.5 bg-indigo-600 hover:bg-indigo-500 text-white text-xs sm:text-sm font-medium rounded-lg transition shadow-sm">
                                    View / Download
                                </a>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="text-center py-12 text-slate-500">
                    <p class="text-lg">No files uploaded to the cloud yet.</p>
                    <p class="text-xs mt-1">Upload your first file above to get started!</p>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>
