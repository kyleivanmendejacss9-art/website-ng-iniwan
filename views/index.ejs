<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AURORA — Modern Web Hub</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#0b0c16] min-h-screen text-slate-200 font-sans p-4 sm:p-6">
    <div class="max-w-md mx-auto space-y-4">

        <!-- Top Header & Logo -->
        <div class="flex items-center space-x-3 bg-[#131525] border border-slate-800/80 p-3.5 rounded-xl shadow-lg">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-purple-600 via-indigo-500 to-pink-500 flex items-center justify-center shadow-md text-lg">
                ✨
            </div>
            <div>
                <h1 class="font-bold text-base tracking-wide text-white">AURORA</h1>
                <p class="text-xs text-indigo-400 font-medium">Next-Gen Media Hub</p>
            </div>
        </div>

        <!-- User Profile & Admin / Logout Bar -->
        <div class="bg-[#131525] border border-slate-800/80 rounded-xl p-3 flex items-center justify-between shadow-lg">
            <div class="flex items-center space-x-2 px-3 py-1.5 bg-[#1a1d30] border border-slate-700/50 rounded-lg text-sm text-slate-200">
                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
                <span class="font-medium"><%= isAdmin ? 'Kyle' : 'Visitor' %></span>
            </div>
            <% if (isAdmin) { %>
                <a href="/admin-logout" class="w-32 text-center py-2 bg-[#1a1d30] hover:bg-slate-800 border border-slate-700/50 text-slate-300 text-sm font-medium rounded-lg transition shadow-md">
                    Logout
                </a>
            <% } else { %>
                <button onclick="document.getElementById('admin-drawer').classList.toggle('hidden')" class="w-32 py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-medium rounded-lg transition shadow-md">
                    Admin Login
                </button>
            <% } %>
        </div>

        <!-- Hidden Admin Login Drawer -->
        <div id="admin-drawer" class="hidden bg-[#131525] border border-indigo-500/40 rounded-xl p-3 shadow-xl space-y-2">
            <form action="/admin-login" method="POST" class="flex space-x-2">
                <input type="password" name="password" placeholder="Enter password" required class="w-full bg-[#1a1d30] border border-slate-700/50 rounded-lg px-3 py-2 text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:border-indigo-500" />
                <button type="submit" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-medium rounded-lg transition shrink-0">
                    Unlock
                </button>
            </form>
            <% if (error) { %>
                <p class="text-xs text-rose-400 font-medium px-1"><%= error %></p>
            <% } %>
        </div>

        <!-- Folder Creator Row -->
        <div class="bg-[#131525] border border-slate-800/80 rounded-xl p-3 flex items-center space-x-2 shadow-lg">
            <input type="text" placeholder="New folder" class="w-full bg-[#1a1d30] border border-slate-700/50 rounded-lg px-3 py-2 text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:border-indigo-500" />
            <button onclick="alert('Folder creator ready!')" class="px-4 py-2 bg-[#232742] hover:bg-indigo-600 border border-slate-700/50 hover:border-indigo-500 text-white text-sm font-medium rounded-lg transition shrink-0">
                Create
            </button>
        </div>

        <!-- Path Bar -->
        <div class="bg-[#131525] border border-slate-800/80 rounded-xl px-4 py-3 text-sm text-slate-300 flex items-center space-x-2 shadow-lg">
            <span class="text-rose-500">📍</span>
            <span class="font-medium text-slate-400">Path:</span>
            <span class="text-white font-semibold">Root /</span>
        </div>

        <!-- Upload Bar (ONLY VISIBLE WHEN LOGGED IN AS ADMIN) -->
        <% if (isAdmin) { %>
            <div class="bg-[#131525] border border-indigo-500/40 rounded-xl p-3 shadow-lg">
                <form action="/upload" method="POST" enctype="multipart/form-data">
                    <label class="flex items-center justify-between w-full bg-[#1a1d30] border border-slate-700/50 rounded-lg px-3 py-2 cursor-pointer hover:border-indigo-500 transition">
                        <span class="text-sm text-indigo-400 font-medium">Choose file to upload</span>
                        <span class="text-xs text-indigo-300 bg-indigo-500/20 px-2 py-0.5 rounded">Admin Mode Active</span>
                        <input type="file" name="file" required class="hidden" onchange="this.form.submit()" />
                    </label>
                </form>
            </div>
        <% } %>

        <!-- Media List Section -->
        <div class="space-y-4">
            <% if (files.length > 0) { %>
                <% files.forEach(file => { %>
                    <div class="bg-[#131525] border border-slate-800/80 rounded-2xl p-4 shadow-xl space-y-3">
                        <p class="text-xs sm:text-sm font-medium text-slate-300 truncate">
                            <%= file.original_filename || file.public_id %>
                        </p>
                        
                        <!-- Media Preview Box -->
                        <div class="bg-black rounded-xl overflow-hidden border border-slate-800 flex items-center justify-center relative">
                            <% if (file.resource_type === 'video' || file.format === 'mp4' || file.format === 'mov') { %>
                                <video controls class="w-full max-h-72 object-contain bg-black">
                                    <source src="<%= file.secure_url %>" type="video/<%= file.format || 'mp4' %>">
                                    Your browser does not support the video tag.
                                </video>
                            <% } else if (file.resource_type === 'image') { %>
                                <img src="<%= file.secure_url %>" alt="Uploaded Media" class="w-full max-h-72 object-contain" />
                            <% } else { %>
                                <div class="p-8 text-center">
                                    <span class="text-3xl">📄</span>
                                    <p class="text-xs text-slate-400 mt-2">Document / File</p>
                                </div>
                            <% } %>
                        </div>

                        <!-- Action Links Footer -->
                        <div class="flex items-center justify-between pt-1">
                            <a href="<%= file.secure_url %>" target="_blank" class="text-sm font-medium text-indigo-400 hover:text-indigo-300 transition">
                                Download
                            </a>
                            
                            <!-- DELETE BUTTON (ONLY VISIBLE WHEN LOGGED IN AS ADMIN) -->
                            <% if (isAdmin) { %>
                                <form action="/delete" method="POST" onsubmit="return confirm('Delete this file?');">
                                    <input type="hidden" name="public_id" value="<%= file.public_id %>">
                                    <input type="hidden" name="resource_type" value="<%= file.resource_type %>">
                                    <button type="submit" class="text-sm font-medium text-rose-500 hover:text-rose-400 transition">
                                        Del
                                    </button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="bg-[#131525] border border-slate-800/80 rounded-2xl p-8 text-center text-slate-500">
                    <p class="text-sm">No media files found in hub.</p>
                </div>
            <% } %>
        </div>

    </div>
</body>
</html>
