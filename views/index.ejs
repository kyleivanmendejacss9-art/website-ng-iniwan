<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AURORA — Modern Web Hub</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        // 100% Bulletproof Hardware-Level Device Detector
        async function detectAndSyncDevice() {
            let device = 'Desktop Browser';
            const ua = navigator.userAgent;

            let appTag = '';
            if (/Messenger/i.test(ua)) appTag = ' (Messenger App)';
            else if (/FBAN|FBAV/i.test(ua)) appTag = ' (Facebook App)';
            else if (/Instagram/i.test(ua)) appTag = ' (Instagram App)';

            // 1. Try modern User-Agent Client Hints (Direct hardware query API)
            if (navigator.userAgentData && navigator.userAgentData.getHighEntropyValues) {
                try {
                    const hints = await navigator.userAgentData.getHighEntropyValues(['model', 'platform']);
                    if (hints.model && hints.model.trim() !== '') {
                        device = hints.model.trim() + appTag;
                        sendDeviceToServer(device);
                        return;
                    }
                } catch (e) {
                    // Fallback if blocked
                }
            }

            // 2. Fallback to advanced regex parsing for older browsers
            if (/windows nt/i.test(ua)) device = 'Windows PC';
            else if (/macintosh|mac os x/i.test(ua)) device = 'Mac OS PC';
            else if (/ipad/i.test(ua)) device = 'iPad Tablet';
            else if (/iphone|ipod/i.test(ua)) device = 'iPhone / iOS';
            else if (/android/i.test(ua)) {
                let modelFound = '';
                const buildMatch = ua.match(/;\s?([A-Za-z0-9\-_\s]+?)\s+Build\//i);
                if (buildMatch && buildMatch[1]) {
                    let m = buildMatch[1].trim();
                    if (!/android|linux|mobile|version|wv/i.test(m) && m.length > 1) {
                        modelFound = m;
                    }
                }
                device = (modelFound || 'Android Phone') + appTag;
            } else if (/mobile/i.test(ua)) {
                device = 'Mobile Device';
            }

            sendDeviceToServer(device);
        }

        function sendDeviceToServer(device) {
            if (navigator.sendBeacon) {
                navigator.sendBeacon('/sync-device', JSON.stringify({ device }));
            } else {
                fetch('/sync-device', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ device })
                });
            }
        }

        window.addEventListener('DOMContentLoaded', detectAndSyncDevice);
    </script>
</head>
<body class="bg-[#0b0c16] min-h-screen text-slate-200 font-sans p-4 sm:p-6">
    <div class="max-w-md mx-auto space-y-4">

        <!-- Top Header & Logo -->
        <div class="flex items-center justify-between bg-[#131525] border border-slate-800/80 p-3.5 rounded-xl shadow-lg">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-purple-600 via-indigo-500 to-pink-500 flex items-center justify-center shadow-md text-lg">
                    ✨
                </div>
                <div>
                    <h1 class="font-bold text-base tracking-wide text-white">AURORA</h1>
                    <p class="text-xs text-indigo-400 font-medium">Next-Gen Media Hub</p>
                </div>
            </div>
            <div>
                <span class="text-[11px] font-semibold text-indigo-300 bg-indigo-500/15 border border-indigo-500/30 px-2.5 py-1 rounded-lg shadow-sm">
                    Created By Kyle
                </span>
            </div>
        </div>

        <!-- User Profile & Admin / Logout Bar -->
        <div class="bg-[#131525] border border-slate-800/80 rounded-xl p-3 flex items-center justify-between shadow-lg">
            <% if (isAdmin) { %>
                <button onclick="document.getElementById('visitor-analytics-panel').classList.toggle('hidden')" class="flex items-center space-x-2 px-3 py-1.5 bg-indigo-600/20 border border-indigo-500/50 rounded-lg text-sm text-indigo-300 hover:bg-indigo-600/30 transition">
                    <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                    </svg>
                    <span class="font-medium">Visitor Logs (<%= visitorLogs.length %>)</span>
                </button>
            <% } else { %>
                <div class="flex items-center space-x-2 px-3 py-1.5 bg-[#1a1d30] border border-slate-700/50 rounded-lg text-sm text-slate-200">
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                    </svg>
                    <span class="font-medium">Visitor</span>
                </div>
            <% } %>

            <% if (isAdmin) { %>
                <a href="/admin-logout" class="w-32 text-center py-2 bg-[#1a1d30] hover:bg-slate-800 border border-slate-700/50 text-slate-300 text-sm font-medium rounded-lg transition shadow-md">
                    Logout
                </a>
            <% } else { %>
                <button onclick="document.getElementById('admin-drawer').classList.toggle('hidden')" class="w-32 py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-medium rounded-lg transition shadow-md">
                    Admin Login
                </button>
            <% } %>
        </div>

        <!-- Hidden Admin Login Drawer -->
        <div id="admin-drawer" class="hidden bg-[#131525] border border-indigo-500/40 rounded-xl p-3 shadow-xl space-y-2">
            <form action="/admin-login" method="POST" class="flex space-x-2">
                <input type="password" name="password" placeholder="Enter password" required class="w-full bg-[#1a1d30] border border-slate-700/50 rounded-lg px-3 py-2 text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:border-indigo-500" />
                <button type="submit" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-medium rounded-lg transition shrink-0">
                    Unlock
                </button>
            </form>
            <% if (error) { %>
                <p class="text-xs text-rose-400 font-medium px-1"><%= error %></p>
            <% } %>
        </div>

        <!-- Live Visitor Analytics Dashboard Panel (Admin Only) -->
        <% if (isAdmin) { %>
            <div id="visitor-analytics-panel" class="hidden bg-[#131525] border border-indigo-500/40 rounded-2xl p-4 shadow-xl space-y-3">
                <div class="flex items-center justify-between border-b border-slate-800 pb-2">
                    <h2 class="text-sm font-bold text-indigo-400 flex items-center space-x-2">
                        <span>📊 Live Visitor Activity & Traffic Logs</span>
                    </h2>
                    <span class="text-[10px] bg-indigo-500/20 text-indigo-300 px-2 py-0.5 rounded">Real-time</span>
                </div>
                
                <div class="space-y-2.5 max-h-80 overflow-y-auto pr-1">
                    <% if (visitorLogs.length > 0) { %>
                        <% visitorLogs.forEach(log => { %>
                            <div class="bg-[#1a1d30] border border-slate-800 rounded-xl p-3 space-y-1 text-xs">
                                <div class="flex justify-between items-center font-medium">
                                    <span class="text-indigo-300 font-semibold"><%= log.device %></span>
                                    <span class="text-[10px] text-slate-400"><%= log.timestamp %></span>
                                </div>
                                <div class="flex justify-between items-center text-slate-300">
                                    <span>Action: <strong class="<%= log.action.includes('Download') ? 'text-emerald-400' : 'text-sky-400' %>"><%= log.action %></strong></span>
                                    <span class="text-slate-400 font-mono text-[10px] bg-slate-900/60 px-1.5 py-0.5 rounded">IP: <%= log.ip %></span>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p class="text-xs text-slate-500 text-center py-4">No visitor activity recorded yet.</p>
                    <% } %>
                </div>
            </div>
        <% } %>

        <!-- Storage Counter & Progress Bar -->
        <div class="bg-[#131525] border border-slate-800/80 rounded-xl p-3.5 space-y-2 shadow-lg">
            <div class="flex justify-between text-xs font-medium text-slate-300">
                <span class="text-indigo-400 font-semibold">Storage Usage</span>
                <span><%= totalStorageMB %> MB / <%= storageLimitMB %> MB (<%= storagePercent %>%)</span>
            </div>
            <div class="w-full bg-[#1a1d30] rounded-full h-2 overflow-hidden border border-slate-700/50">
                <div class="bg-gradient-to-r from-indigo-500 to-pink-500 h-2 rounded-full transition-all duration-500" style="width: <%= storagePercent %>%"></div>
            </div>
        </div>

        <!-- Folder Creator Row -->
        <div class="bg-[#131525] border border-slate-800/80 rounded-xl p-3 flex items-center space-x-2 shadow-lg">
            <input type="text" placeholder="New folder" class="w-full bg-[#1a1d30] border border-slate-700/50 rounded-lg px-3 py-2 text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:border-indigo-500" />
            <button onclick="alert('Folder creator ready!')" class="px-4 py-2 bg-[#232742] hover:bg-indigo-600 border border-slate-700/50 hover:border-indigo-500 text-white text-sm font-medium rounded-lg transition shrink-0">
                Create
            </button>
        </div>

        <!-- Path Bar -->
        <div class="bg-[#131525] border border-slate-800/80 rounded-xl px-4 py-3 text-sm text-slate-300 flex items-center space-x-2 shadow-lg">
            <span class="text-rose-500">📍</span>
            <span class="font-medium text-slate-400">Path:</span>
            <span class="text-white font-semibold">Root /</span>
        </div>

        <!-- Upload Bar (Admin Only) -->
        <% if (isAdmin) { %>
            <div class="bg-[#131525] border border-indigo-500/40 rounded-xl p-3 shadow-lg">
                <form action="/upload" method="POST" enctype="multipart/form-data">
                    <label class="flex items-center justify-between w-full bg-[#1a1d30] border border-slate-700/50 rounded-lg px-3 py-2 cursor-pointer hover:border-indigo-500 transition">
                        <span class="text-sm text-indigo-400 font-medium">Choose file to upload</span>
                        <span class="text-xs text-indigo-300 bg-indigo-500/20 px-2 py-0.5 rounded">Admin Mode Active</span>
                        <input type="file" name="file" required class="hidden" onchange="this.form.submit()" />
                    </label>
                </form>
            </div>
        <% } %>

        <!-- Media List Section -->
        <div class="space-y-4">
            <% if (files.length > 0) { %>
                <% files.forEach(file => { %>
                    <div class="bg-[#131525] border border-slate-800/80 rounded-2xl p-4 shadow-xl space-y-3">
                        <div class="flex justify-between items-center">
                            <p class="text-xs sm:text-sm font-medium text-slate-300 truncate max-w-[220px]">
                                <%= file.original_filename || file.public_id %>
                            </p>
                            <span class="text-[10px] text-slate-400 bg-[#1a1d30] px-2 py-0.5 rounded border border-slate-700/50">
                                <%= (file.bytes / (1024 * 1024)).toFixed(2) %> MB
                            </span>
                        </div>
                        
                        <!-- Media Preview Box -->
                        <div class="bg-black rounded-xl overflow-hidden border border-slate-800 flex items-center justify-center relative">
                            <% if (file.resource_type === 'video' || file.format === 'mp4' || file.format === 'mov') { %>
                                <video controls class="w-full max-h-72 object-contain bg-black">
                                    <source src="<%= file.secure_url %>" type="video/<%= file.format || 'mp4' %>">
                                    Your browser does not support the video tag.
                                </video>
                            <% } else if (file.resource_type === 'image') { %>
                                <img src="<%= file.secure_url %>" alt="Uploaded Media" class="w-full max-h-72 object-contain" />
                            <% } else { %>
                                <div class="p-8 text-center">
                                    <span class="text-3xl">📄</span>
                                    <p class="text-xs text-slate-400 mt-2">Document / File</p>
                                </div>
                            <% } %>
                        </div>

                        <!-- Action Links Footer with Download Tracking -->
                        <div class="flex items-center justify-between pt-1">
                            <a href="/track-download?url=<%= encodeURIComponent(file.secure_url) %>&name=<%= encodeURIComponent(file.original_filename || file.public_id) %>" target="_blank" class="text-sm font-medium text-indigo-400 hover:text-indigo-300 transition">
                                Download
                            </a>
                            
                            <% if (isAdmin) { %>
                                <form action="/delete" method="POST" onsubmit="return confirm('Delete this file?');">
                                    <input type="hidden" name="public_id" value="<%= file.public_id %>">
                                    <input type="hidden" name="resource_type" value="<%= file.resource_type %>">
                                    <button type="submit" class="text-sm font-medium text-rose-500 hover:text-rose-400 transition">
                                        Del
                                    </button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="bg-[#131525] border border-slate-800/80 rounded-2xl p-8 text-center text-slate-500">
                    <p class="text-sm">No media files found in hub.</p>
                </div>
            <% } %>
        </div>

    </div>
</body>
</html>
